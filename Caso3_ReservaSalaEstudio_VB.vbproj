<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <RootNamespace></RootNamespace>
    <StartupObject>PRO205.Semana7.Caso3.ReservaSalaEstudio.VB.Program</StartupObject>
    <AssemblyName>Caso3_ReservaSalaEstudio_VB</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="FrmReservaSalaEstudio.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmReservaSalaEstudio.Designer.vb">
      <DependentUpon>FrmReservaSalaEstudio.vb</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <EmbeddedResource Update="FrmReservaSalaEstudio.resx">
      <DependentUpon>FrmReservaSalaEstudio.vb</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
</Project>
